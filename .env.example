# API root, without /v1 or /v1/systemone. This file is not automatically loaded.
SYSTEM_ONE_BASE_URL=http://localhost:8009
# For a local Kev server without authentication, explicitly use a dummy value.
SYSTEM_ONE_API_KEY=local-unused
SYSTEM_ONE_MODEL=kev-latest
SYSTEM_ONE_TIMEOUT=30
SYSTEM_ONE_MAX_RETRIES=0
